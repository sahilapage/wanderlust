<% if(created && created.length) { %>
  <div class="alert alert-success alert-dismissible fade show col-6 offset-3 mt-3" role="alert">
     <%= created %>
     <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

