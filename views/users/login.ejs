<% layout("/layouts/landing_boilerplate") -%>
<div class="row">
    <h1 class="col-6 offset-3"><a class="navbar-brand" href="/"><i class="fa-regular fa-compass"></i></a> WanderLust</h1>
    <h3 class="col-6 offset-3">Log in</h3>
    <div class="col-6 offset-3">
        <form method="POST", action="login" novalidate class="needs-validation">
            <div class="mt-2">
              <label for="username" class="form-label">Username</label>
              <input name="username" id="username" type="text" class="form-control">
             </div>
             <div class="mt-2">
              <label for="password" class="form-label">Password</label>
              <input name="password" id="password" type="password" class="form-control" >
             </div>
             <button class="btn btn-dark add-btn mt-3 mb-3">Log in</button>
             <div class="mb-3"> Don't have an account? <a href="/signup">Sign up</a> </div>
        </form>
    </div>
</div>