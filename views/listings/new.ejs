<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
<body>
    <br>
    <h3>Create new listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div>
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" placeholder="Title" type="text" class="form-control" required>
            <div class="invalid-feedback">
              Please enter a valid title.
            </div>
        </div>
        <br>
        <div>
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" placeholder="...." class="form-control" required></textarea>
            <div class="invalid-feedback">
              Please enter a valid description.
            </div>
        </div>
        <br>
        <div>
            <label for="image" class="form-label">Upload Image</label>
            <input name="listing[image]" type="file" class="form-control" required>
        </div>
        <br>
        <div class="row">
            <div class="col-md-6">
            <label for="price" class="form-label" >Price</label>
            <input name="listing[price]" placeholder="1200" type="number" class="form-control" required>
            <div class="invalid-feedback">
              Please enter a valid price.
            </div>
            </div>
         <br>   
            <!-- <div class="col-md-6">
            <label for="category" class="form-label">Category</label>
            <input name="listing[category]" placeholder="Rooms" type="text" class="form-control" required>
            <div class="invalid-feedback">
              Please enter a category
            </div>
        </div> -->
        <div class="col-md-6">
            <label for="category" class="form-label">Category</label>
            <select name="listing[category]" id="category" class="form-select">
             <option value="" selected disabled>Choose a category</option>
             <option value="Rooms">Rooms</option>
             <option value="Farms">Farms</option>
             <option value="Cabins">Cabins</option>
             <option value="Mountains">Mountains</option>
             <option value="Castles">Castles</option>
             <option value="Camping">Camping</option>
             <option value="Jungles">Jungles</option>
             <option value="Arctic">Arctic</option>
             <option value="Deserts">Deserts</option>
             <option value="Beachs">Beachs</option>
             <option value="Lakefront">Lakefront</option>
             <option value="Iconic cities">Iconic cities</option>
             <option value="Trending">Trending</option>
            </select>
          <div class="invalid-feedback">
             Please select a category
        </div>
         </div>

        </div>
        <br>
        <div class="row">
          <div class="col-md-8">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required>
            <div class="invalid-feedback">
              Please enter a valid location.
            </div>
          </div>
     <br>     
          <div class="col-md-4">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
            <div class="invalid-feedback">
              Please enter a valid country.
            </div>
            </div>
        </div>
        <br><br>
        <button class="btn btn-dark add-btn mb-3">Add</button>
    </form>
</body>
</div>
</div>